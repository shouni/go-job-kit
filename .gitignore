# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov
*.prof

# Go workspace file
go.work
go.work.sum

# ローカルのビルド成果物とキャッシュ
/bin/
/.cache/
/.gocache/

# env file
.env
.env.*

# 秘密情報（実在しなくても、置かれたら commit してはいけないもの）
credentials.json
*.key
*.pem

# Claude Code のローカル設定
.claude/settings.local.json

# エディタ / OS（マシンをまたぐためリポジトリ側に持つ）
.DS_Store
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.code-workspace
